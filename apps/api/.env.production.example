# ===========================================
# WhatsApp CRM - Production Environment
# ===========================================
# IMPORTANT: Copy this file to .env.production and fill in all values
# NEVER commit the actual .env.production file to version control

# ===========================================
# CRITICAL SECURITY - MUST CHANGE IN PRODUCTION
# ===========================================

# Generate with: openssl rand -base64 64
JWT_SECRET=your-secure-jwt-secret-min-64-characters-long-change-this

# Generate with: openssl rand -base64 64
JWT_REFRESH_SECRET=your-secure-refresh-secret-min-64-characters-long-change-this

# Must be exactly 32 characters. Generate with: openssl rand -base64 24 | head -c 32
ENCRYPTION_KEY=your-32-character-encryption-key

# ===========================================
# APPLICATION SETTINGS
# ===========================================
NODE_ENV=production
PORT=3005

# Your production domain (no trailing slash)
CORS_ORIGIN=https://your-domain.com

# ===========================================
# DATABASE
# ===========================================
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL=postgresql://postgres:your-secure-password@localhost:5432/whatsapp_crm?schema=public

# ===========================================
# REDIS
# ===========================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=your-redis-password

# ===========================================
# MINIO / S3 STORAGE
# ===========================================
MINIO_ENDPOINT=your-minio-or-s3-endpoint
MINIO_PORT=9000
MINIO_USE_SSL=true
MINIO_ACCESS_KEY=your-minio-access-key
MINIO_SECRET_KEY=your-minio-secret-key
MINIO_BUCKET=whatsapp-crm-production

# ===========================================
# JWT TOKEN EXPIRATION
# ===========================================
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ===========================================
# RATE LIMITING (per IP)
# ===========================================
THROTTLE_TTL=60000
THROTTLE_LIMIT=100

# ===========================================
# LOGGING
# ===========================================
LOG_LEVEL=info

# ===========================================
# OPTIONAL: ERROR TRACKING (Sentry)
# ===========================================
# SENTRY_DSN=https://your-sentry-dsn
