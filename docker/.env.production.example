# ===========================================
# WhatsApp CRM - Production Environment
# Copy this to .env.production and fill in values
# ===========================================

# --- Database (NeonDB) ---
DATABASE_URL=postgresql://username:password@your-neondb-host.neon.tech/whatsapp_crm?sslmode=require

# --- Redis (Upstash) ---
REDIS_HOST=your-redis-host.upstash.io
REDIS_PORT=6379
REDIS_PASSWORD=your-upstash-password

# --- JWT Secrets (generate strong random strings) ---
# Generate with: openssl rand -base64 32
JWT_SECRET=your-super-secret-jwt-key-min-32-chars
JWT_EXPIRES_IN=1d
JWT_REFRESH_SECRET=your-super-secret-refresh-key-min-32-chars
JWT_REFRESH_EXPIRES_IN=7d

# --- Encryption Key (exactly 32 characters) ---
# Generate with: openssl rand -base64 24 | head -c 32
ENCRYPTION_KEY=your-32-character-encryption-key

# --- CORS ---
# Your frontend domain(s), comma-separated
CORS_ORIGIN=https://your-frontend-domain.com

# --- Ports ---
API_PORT=3001
WEB_PORT=3000

# --- Frontend Build Args ---
# API URL that the frontend will use (relative or absolute)
# If using reverse proxy: /api/v1
# If direct access: https://api.yourdomain.com/api/v1
VITE_API_URL=/api/v1
