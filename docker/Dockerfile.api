# Build stage
FROM node:20-alpine AS builder

LABEL maintainer="WhatsApp CRM Team"
LABEL version="1.0"
LABEL description="WhatsApp CRM API Service"

WORKDIR /app

# Install build dependencies
RUN apk add --no-cache python3 make g++

# Copy package files
COPY package.json ./
COPY apps/api/package.json ./apps/api/
COPY packages/shared/package.json ./packages/shared/

# Create workspace structure for npm
RUN echo '{"workspaces": ["apps/*", "packages/*"]}' > package.json

# Install dependencies using npm
WORKDIR /app/apps/api
RUN npm install --legacy-peer-deps

WORKDIR /app/packages/shared
RUN npm install --legacy-peer-deps

# Copy source files
WORKDIR /app
COPY tsconfig.base.json ./
COPY apps/api ./apps/api
COPY packages/shared ./packages/shared

# Generate Prisma client
WORKDIR /app/apps/api
RUN npx prisma generate

# Build shared package first
WORKDIR /app/packages/shared
RUN npm run build || true

# Build API
WORKDIR /app/apps/api
RUN npm run build

# Production stage
FROM node:20-alpine AS runner

RUN addgroup -g 1001 -S nodejs && \
    adduser -S nodejs -u 1001

WORKDIR /app

# Install dumb-init for proper signal handling
RUN apk add --no-cache dumb-init

# Copy built files and dependencies
COPY --from=builder /app/apps/api/dist ./dist
COPY --from=builder /app/apps/api/prisma ./prisma
COPY --from=builder /app/apps/api/node_modules ./node_modules
COPY --from=builder /app/apps/api/package.json ./

# Create WhatsApp sessions directory
RUN mkdir -p /app/.whatsapp-sessions

# Set permissions
RUN chown -R nodejs:nodejs /app

USER nodejs

ENV NODE_ENV=production
ENV PORT=3001

EXPOSE 3001

HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=3 \
  CMD wget --no-verbose --tries=1 --spider http://localhost:3001/api/health || exit 1

ENTRYPOINT ["dumb-init", "--"]

CMD ["sh", "-c", "npx prisma db push --accept-data-loss && node dist/main.js"]
